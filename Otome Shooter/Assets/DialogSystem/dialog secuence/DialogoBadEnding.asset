    characterVisibility: 0
    useScoreDialogue: 0
    minimumScore: 0
    lowScoreText: 
    highScoreText: 
  - character: {fileID: 0}
    text: "Al final Aliza volvi\xF3 a su habitaci\xF3n arrepentida de no haber dejado de disociar."
