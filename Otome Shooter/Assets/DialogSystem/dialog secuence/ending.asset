%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87da3c32bf5c9ba46b04abc88abbf11e, type: 3}
  m_Name: ending
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  lines:
  - character: {fileID: 11400000, guid: 0a183ea4b7fb77a46b51313d875b10cb, type: 2}
    text: "(Aparece una carpeta en la interfaz)\r\nArchivo encontrado: \u201CSOFIA_LOG_FINAL.AUD\u201D\r\n(reproduce
      la grabaci\xF3n)"
  - character: {fileID: 11400000, guid: 313824df32435294fa6e344d8f846603, type: 2}
    text: "\u2014Pap\xE1\u2026 si est\xE1s escuchando esto, significa que llegaste
      al Refugio 73.\r\nNo s\xE9 cu\xE1nto tiempo ha pasado, pero\u2026 lo lograste."
  - character: {fileID: 11400000, guid: 313824df32435294fa6e344d8f846603, type: 2}
    text: "\u2014Nos quedamos aqu\xED despu\xE9s del ataque.\r\nEl grupo logr\xF3
      escapar del frente enemigo, pero el invierno fue implacable."
  - character: {fileID: 11400000, guid: 313824df32435294fa6e344d8f846603, type: 2}
    text: "La energ\xEDa del refugio comenz\xF3 a fallar\u2026 los filtros de aire
      colapsaron\u2026\r\ny uno a uno\u2026 todos se fueron cayendo."
  - character: {fileID: 11400000, guid: 313824df32435294fa6e344d8f846603, type: 2}
    text: "\u2014Yo fui la \xFAltima.\r\nIntent\xE9 mantener las se\xF1ales activas
      el mayor tiempo posible,\r\npor si alg\xFAn d\xEDa lograbas o\xEDrme."
  - character: {fileID: 11400000, guid: 313824df32435294fa6e344d8f846603, type: 2}
    text: "(se nota una sonrisa triste en su voz)\r\n\u2014No quiero que sientas
      culpa."
  - character: {fileID: 11400000, guid: 313824df32435294fa6e344d8f846603, type: 2}
    text: "Viv\xED una buena vida, pap\xE1.\r\nAprend\xED a sobrevivir, conoc\xED
      gente buena, y nunca perd\xED la esperanza de verte de nuevo."
  - character: {fileID: 11400000, guid: 313824df32435294fa6e344d8f846603, type: 2}
    text: "(su voz se quiebra levemente)\r\n\u2014No importa la distancia, ni el
      tiempo\u2026\r\nsi el silencio vuelve\u2026 no tengas miedo."
  - character: {fileID: 11400000, guid: 313824df32435294fa6e344d8f846603, type: 2}
    text: "Mientras exista una se\xF1al\u2026\r\n\u2014Siempre\u2026 conectados.."
  - character: {fileID: 11400000, guid: 039f7ea10be1c034891c78d336b0051a, type: 2}
    text: "(la transmisi\xF3n se corta. ruido de interferencia)"
  - character: {fileID: 11400000, guid: 9f1001abb7e4a5a489b0b32a62dbf20b, type: 2}
    text: "(suspira)\r\nSof\xEDa\u2026\r\nviviste con m\xE1s valor del que este mundo
      merec\xEDa."
  - character: {fileID: 11400000, guid: 9f1001abb7e4a5a489b0b32a62dbf20b, type: 2}
    text: "Y aunque el mundo est\xE9 muerto\u2026\r\ntu voz segu\xEDa viva."
  - character: {fileID: 11400000, guid: 9f1001abb7e4a5a489b0b32a62dbf20b, type: 2}
    text: "(enciende el comunicador una \xFAltima vez)\r\nAqu\xED Elric\u2026 mi
      \xFAltimo registro."
  - character: {fileID: 11400000, guid: 9f1001abb7e4a5a489b0b32a62dbf20b, type: 2}
    text: "Si alguien escucha esto\u2026\r\nmantengan la se\xF1al activa."
  - character: {fileID: 11400000, guid: 9f1001abb7e4a5a489b0b32a62dbf20b, type: 2}
    text: "Porque mientras alguien escuche\u2026\r\nella nunca se habr\xE1 ido."
  - character: {fileID: 11400000, guid: 9f1001abb7e4a5a489b0b32a62dbf20b, type: 2}
    text: "(mira el horizonte nevado, mientras la nieve cae lentamente) Aqu\xED termina
      la b\xFAsqueda\u2026 "
